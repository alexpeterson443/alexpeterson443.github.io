+// ---------- Recent: swipe a graded row left to hide it ----------
+// A short swipe leaves the Hide button showing; a long one (or a quick flick) hides it right away.
+const SWIPE_OPEN = 88;
+let swipe = null;       // the row being dragged: { el, x, y, base, dx, t, id, active }
+let openSwipe = null;   // a row left open with Hide showing
+function settleSwipe(el, x) {
+  const row = el.querySelector(".arow");
+  el.classList.remove("dragging");
+  el.classList.toggle("open", !!x);
+  if (row) row.style.transform = x ? `translateX(${x}px)` : "";
+  if (openSwipe === el && !x) openSwipe = null;
+  if (x) openSwipe = el;
+  else setTimeout(() => { if (!el.classList.contains("dragging") && !el.classList.contains("open")) el.classList.remove("swiping"); }, 360);
+}
+function hideFromRecent(el) {
+  const url = el.dataset.swipe;
+  const a = findAssignment(url);
+  if (!a?.gradedAt || el.classList.contains("leaving")) return;
+  if (openSwipe === el) openSwipe = null;
+  el.classList.remove("dragging", "open");
+  el.classList.add("swiping", "leaving");
+  el.style.height = `${el.offsetHeight}px`;
+  el.querySelector(".arow").style.transform = "translateX(-100%)";
+  requestAnimationFrame(() => { el.style.height = "0px"; });
+  setTimeout(() => {
+    setHiddenRecent({ ...hiddenRecent, [url]: a.gradedAt });
+    render();
+    const name = a.name.length > 32 ? `${a.name.slice(0, 31)}…` : a.name;
+    showToast(`Hid “${name}” from Recent`, () => {
+      const next = { ...hiddenRecent };
+      delete next[url];
+      setHiddenRecent(next);
+      render();
+    });
+  }, 380);
+}
+document.addEventListener("pointerdown", (e) => {
+  const el = e.target.closest(".swipe");
+  if (openSwipe && openSwipe !== el) settleSwipe(openSwipe, 0);
+  if (!el || e.button > 0 || e.target.closest(".swipe-act") || el.classList.contains("leaving")) return;
+  swipe = { el, x: e.clientX, y: e.clientY, base: el.classList.contains("open") ? -SWIPE_OPEN : 0, dx: 0, t: e.timeStamp, id: e.pointerId, active: false };
+});
+document.addEventListener("pointermove", (e) => {
+  if (!swipe || e.pointerId !== swipe.id) return;
+  const dx = e.clientX - swipe.x, dy = e.clientY - swipe.y;
+  if (!swipe.active) {
+    if (Math.abs(dy) > 10 && Math.abs(dy) >= Math.abs(dx)) { swipe = null; return; } // scrolling, not swiping
+    if (Math.abs(dx) < 10 || Math.abs(dx) < Math.abs(dy) * 1.2) return;
+    if (dx > 0 && !swipe.base) { swipe = null; return; }                            // only leftward opens it
+    swipe.active = true;
+    swipe.el.classList.add("dragging", "swiping");
+    try { swipe.el.setPointerCapture(e.pointerId); } catch {}
+  }
+  const x = Math.min(0, swipe.base + dx);
+  swipe.dx = x;
+  swipe.el.querySelector(".arow").style.transform = `translateX(${x}px)`;
+});
+function endSwipe(e) {
+  if (!swipe || e.pointerId !== swipe.id) return;
+  const s = swipe;
+  swipe = null;
+  const blockTap = () => { swallowClick = true; setTimeout(() => { swallowClick = false; }, 400); };
+  if (!s.active) {
+    // Tapping a row that's open just closes it
+    if (s.base && e.type === "pointerup") { blockTap(); settleSwipe(s.el, 0); }
+    return;
+  }
+  blockTap();
+  const flick = e.timeStamp - s.t < 260 && s.dx < -SWIPE_OPEN;
+  if (e.type === "pointerup" && (s.dx < -s.el.offsetWidth * 0.5 || flick)) hideFromRecent(s.el);
+  else if (e.type === "pointerup" && s.dx < -SWIPE_OPEN * 0.6) settleSwipe(s.el, -SWIPE_OPEN);
+  else settleSwipe(s.el, 0);
+}
