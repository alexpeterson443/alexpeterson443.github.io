 const offline = (a) => a.submissionTypes.length > 0 && a.submissionTypes.every((t) => t === "none" || t === "on_paper");
+// Work Canvas can't see: "In class" only when it's due on a day that class meets (COURSE_CATALOG meets,
+// Chicago time). Otherwise say what Canvas actually knows, rather than guess it happens in class.
+const weekdayFmt = new Intl.DateTimeFormat("en-US", { timeZone: "America/Chicago", weekday: "short" });
+function offlineLabel(a) {
+  const course = (data?.courses || []).find((c) => c.name === a.course);
+  const meets = course && catalogFor(course)?.meets;
+  if (meets && a.due && meets.includes(weekdayFmt.format(new Date(a.due)))) return "In class";
+  return a.submissionTypes.includes("on_paper") ? "On paper" : "No online turn-in";
+}
 // Attendance is the teacher taking roll in class. Canvas gives it a due time (when class meets), but it isn't
